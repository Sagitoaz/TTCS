# ============================================
# Unity .gitignore - Chuẩn cho teamwork
# ============================================

# Unity generated folders - KHÔNG commit
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# ============================================
# IDE và Editor Settings - Cá nhân hóa
# ============================================

# Visual Studio / Visual Studio Code
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user

# JetBrains Rider
.idea/
/[Aa]ssets/Plugins/Editor/JetBrains*

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db.meta
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================
# Unity specific files - Tự động generate
# ============================================

# Crash reports
sysinfo.txt
mono_crash.*

# Unity meta files của binary files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Build files và packages
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
*.ipa
*.exe
*.x86
*.x86_64

# Blender backup files
*.blend1
*.blend1.meta

# ============================================
# Asset Store và Plugins
# ============================================

# Uncomment nếu không muốn commit Asset Store Tools
# /[Aa]ssets/AssetStoreTools*

# ============================================
# Addressables
# ============================================

/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/addressables_content_state.bin*
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/ServerData/

# ============================================
# Visual Scripting
# ============================================

/[Aa]ssets/Unity.VisualScripting.Generated/

# ============================================
# Test Runner
# ============================================

/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
InitTestScene*.unity*

# ============================================
# Crashlytics
# ============================================

crashlytics-build.properties
fabric.properties

# ============================================
# Gradle (Android builds)
# ============================================

.gradle/
/[Bb]uild/

# ============================================
# Fmod (nếu dùng)
# ============================================

/[Aa]ssets/Plugins/FMOD/Cache/
/[Aa]ssets/Plugins/FMOD/Cache.meta
fmod.log
fmod_editor.log

# ============================================
# TextMesh Pro (nếu dùng)
# ============================================

# Uncomment nếu không muốn commit TMP settings
# /[Aa]ssets/TextMesh Pro/

# ============================================
# Plastic SCM (Version Control)
# ============================================

.plastic/
plastic.workspace
plastic.selector
plastic.changes

# ============================================
# Other
# ============================================

# Backup files
*.backup
*.bak
*~

# Log files
*.log

# Temporary files
*.tmp
.utmp/

.aidlc-rule-details/
.copilot/
.github/
aidlc-docs/
AGENTS.md